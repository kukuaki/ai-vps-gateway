{
  "name": "ai-vps-gateway",
  "version": "0.1.1",
  "private": true,
  "description": "Local-first MCP gateway and WebUI for VPS operations.",
  "author": "kukuaki",
  "license": "MIT",
  "homepage": "https://github.com/kukuaki/ai-vps-gateway",
  "repository": {
    "type": "git",
    "url": "https://github.com/kukuaki/ai-vps-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/kukuaki/ai-vps-gateway/issues"
  },
  "keywords": [
    "mcp",
    "vps",
    "aiops",
    "devops",
    "ssh",
    "electron",
    "claude",
    "codex"
  ],
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch server/entry.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "start": "NODE_ENV=production tsx server/entry.ts",
    "mcp": "tsx mcp/index.ts",
    "sync:all-vps": "tsx scripts/sync-all-vps.ts",
    "sync:vps-projects": "tsx scripts/sync-vps-projects.ts",
    "collect:all-metrics": "tsx scripts/collect-all-metrics.ts",
    "seed:demo": "tsx scripts/seed-demo-data.ts",
    "check:release-safety": "tsx scripts/check-release-safety.ts",
    "import:all-vps-credentials": "tsx scripts/import-all-vps-credentials.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.desktop.json",
    "test": "tsx --test server/**/*.test.ts desktop/**/*.test.ts",
    "build:desktop-runtime": "node scripts/build-desktop.mjs",
    "build:desktop": "npm run build && npm run build:desktop-runtime",
    "run:desktop": "npm run build:desktop && electron dist-electron/main.cjs",
    "package:desktop": "npm run build:desktop && electron-builder --mac --arm64"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@lucide/vue": "^1.30.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fastify": "^5.11.3",
    "vue": "^3.5.41",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^10.0.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vue-tsc": "^3.3.9"
  },
  "build": {
    "appId": "me.kukuaki.ai-vps-gateway",
    "productName": "AI VPS Gateway",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "icon": "assets/app-icon.png",
    "files": [
      "dist-electron/**",
      "package.json",
      "!**/*.map",
      "!**/.env",
      "!**/.env.*"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist-electron/mcp.cjs",
        "to": "mcp.cjs"
      },
      {
        "from": "assets/menubar-template.png",
        "to": "menubar-template.png"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
