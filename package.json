{
  "name": "ai-vps-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first MCP gateway and WebUI for VPS operations.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "start": "NODE_ENV=production tsx server/main.ts",
    "mcp": "tsx mcp/index.ts",
    "sync:all-vps": "tsx scripts/sync-all-vps.ts",
    "import:all-vps-credentials": "tsx scripts/import-all-vps-credentials.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json",
    "test": "tsx --test server/**/*.test.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@lucide/vue": "^1.30.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fastify": "^5.11.3",
    "vue": "^3.5.41",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^10.0.4",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vue-tsc": "^3.3.9"
  }
}
