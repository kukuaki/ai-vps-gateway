# All values are optional. Never put private keys, tokens, or passwords here.
ALLVPS_DATA_DIR=
ALLVPS_PROBE_INTERVAL_MS=30000
PORT=4318
ALLVPS_API_URL=http://127.0.0.1:4318
# Default: ~/Desktop/all-vps. The synchronizer reads only VPS_INVENTORY.md and DOMAINS.md.
ALLVPS_SOURCE_DIR=
# Default on macOS: ~/Library/Application Support/AI VPS Gateway/credentials
ALLVPS_CREDENTIAL_DIR=
# Default: ~/.ssh/known_hosts. The gateway requires existing host fingerprints.
ALLVPS_KNOWN_HOSTS_FILE=
ALLVPS_SSH_BIN=ssh
ALLVPS_SESSION_IDLE_MS=1800000
ALLVPS_SESSION_MAX_MS=28800000
ALLVPS_SESSION_SWEEP_MS=30000
ALLVPS_COMMAND_RETENTION_MS=7776000000
